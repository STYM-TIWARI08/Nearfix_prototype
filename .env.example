# NearFix local configuration
PORT=5050
JWT_SECRET=change-this-in-production

# Optional real administrator account (no demo admin is created by default)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=NearFix Admin
ADMIN_AREA=All Areas

# TinyFish Web Agent. Add your key to a private .env file; never place it in frontend code.
TINYFISH_API_KEY=

# Optional Razorpay TEST gateway. Manual UPI QR + Cash verification work without keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# No Google Maps API key is required.
# Maps: OpenStreetMap + Leaflet | Routing: OSRM | GPS: browser Geolocation API

# Optional real SMS delivery for the ARRIVAL OTP only.
# Without these values, demo mode shows the generated arrival OTP in the customer verification dialog.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# SQL persistence (Supabase PostgreSQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase persistence: run docs/sql-persistence.sql first.
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
